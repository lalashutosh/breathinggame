; Engine configuration file.
config_version=5

[application]
config/name="ΑΝΑΣΑ · Immersive"
config/description="A quiet valley, a few stray sheep."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
Game="*res://autoload/game.gd"
Breath="*res://autoload/breath.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.14, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[shader_globals]
world_val={"type":"float","value":0.0}
wind_theta={"type":"float","value":0.0}
gust={"type":"float","value":0.3}
sync_amt={"type":"float","value":0.0}
player_pos={"type":"vec2","value":Vector2(0, 78)}
grass_base={"type":"color","value":Color(0.3, 0.4, 0.15, 1)}
grass_tip={"type":"color","value":Color(0.85, 0.75, 0.4, 1)}
sun_dir={"type":"vec3","value":Vector3(0, 0.3, -1)}
sun_col={"type":"color","value":Color(1, 0.9, 0.7, 1)}
